---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import ClientLogos from '../components/ClientLogos.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import PressFeature from '../components/PressFeature.astro';
import HomeTrust from '../components/HomeTrust.astro';
import { founderBios, houseStats, replyTime } from '../i18n/house';
import heroBridge from '../assets/img/hero-bridge.jpg';
import framedFounders from '../assets/img/framed-founders.png';
import heroPour from '../assets/img/hero-pour.jpg';
import svcTeam from '../assets/img/svc-team.jpg';
import classHero from '../assets/img/class-hero.webp';
import miamiSunset from '../assets/img/miami-sunset.jpg';
import cocktailHectorMocktail from '../assets/img/cocktail-hector-mocktail.webp';
import founderFabioPortrait from '../assets/img/founder-fabio-portrait.jpg';
import cocktailSunsetMarg from '../assets/img/cocktail-sunset-marg.webp';
import evGrandopeningWoabar from '../assets/img/ev-grandopening-woabar.webp';
import { priceFrom } from '../i18n/pricing';

// Home services rail. Four core service lines, each with its starting price
// pulled from the shared pricing module (src/i18n/pricing.ts).
const SERVICES = [
  {
    id: 'svc-mobile-bar',
    n: '01', img: heroPour, tag: 'Flagship', href: '/mobile-bar',
    title: ['Full-Service ', 'Mobile Bar'], it: ' Experience',
    desc: 'Our signature experience. Luxury mobile bars, signature cocktails and a full hospitality team, curated end-to-end for weddings, private events and brand moments.',
    list: ['Luxury bar setup', 'Signature cocktails', 'Premium mixers & garnish', 'Bartenders & hosts', 'Setup & breakdown'],
    meta: priceFrom('mobilebar', 'en'),
  },
  {
    id: 'svc-staffing',
    n: '02', img: svcTeam, tag: 'Staffing', href: '/staffing',
    title: ['Bartending &', 'Hospitality'], it: ' Staffing',
    desc: 'Experienced bartenders and hospitality professionals trained in elevated, guest-focused service for private, corporate and luxury events.',
    list: ['Bartenders', 'Hosts & captains', 'Barbacks', 'Event leads'],
    meta: priceFrom('bartending', 'en'),
  },
  {
    id: 'svc-classes',
    n: '03', img: classHero, tag: 'Experiences', href: '/classes',
    title: ['Mixology'], it: ' Classes',
    desc: 'Interactive cocktail classes that combine entertainment, education and hospitality, led by professional mixologists, hands-on from first shake to final pour.',
    list: ['Team building', 'Brand activations', 'Private groups', 'Off-sites'],
    meta: priceFrom('classes', 'en'),
  },
  {
    id: 'svc-bar-rentals',
    n: '04', img: evGrandopeningWoabar, tag: 'Bar only', href: '/bar-rentals',
    title: ['Bar'], it: ' Rentals',
    desc: 'Just the bar. We deliver it, set it up styled and service ready, and collect it after. You stock it, you staff it, you run the night your way.',
    list: ['Delivery & setup', 'Styled on arrival', 'Pickup included', 'Add staff any time'],
    meta: priceFrom('rentals', 'en'),
  },
];

const MARQUEE = [
  'Weddings', '★', 'Luxury Private Events', '★', 'Corporate Activations',
  '★', 'Brand Pop-Ups', '★',
  'Mixology Classes', '★', 'Hospitality Staffing',
];
const MARQUEE_ALL = [...MARQUEE, ...MARQUEE];

---

<Layout title="WOA Cocktails. Luxury Hospitality & Beverage House · NYC & Miami">
  {/* ── Hero ── */}
  <section class="hero" id="top">
    <div class="hero-bg">
      <Pic src={heroBridge} alt="WOA Cocktails, luxury mobile bar service" kind="hero" priority />
    </div>
    <div class="hero-content wrap">
      <div class="hero-top">
        <span class="eyebrow">A Hospitality &amp; Beverage House · Est. 2020</span>
        <span class="eyebrow dim" style="text-align:right;line-height:1.7">
          New York · Tri-State<br />Miami · Downtown
        </span>
      </div>

      <div class="hero-body">
        <div>
          <span class="hero-rule"></span>
          <h1 class="display h-xl">A work of <em>art</em><br />in every pour.</h1>
          <div class="hero-cta">
            <a href="/contact#inquiry-form" class="btn btn-solid">Get a Quote</a>
            <a href="#services" class="btn btn-ghost">Explore services</a>
          </div>
        </div>
        <aside class="hero-aside">
          WOA is a full-service luxury hospitality &amp; beverage house,
          crafting elevated mobile bar experiences, cocktail programs and
          curated activations for weddings, corporate events and brand moments
          across <b style="color:var(--fg)">New York</b> and <b style="color:var(--fg)">Miami</b>.
          <div class="stat-row">
            {[houseStats.en.experience, houseStats.en.events].map((stat) => (
              <div class="stat"><b>{stat.b}</b><span>{stat.label}</span></div>
            ))}
          </div>
        </aside>
      </div>

      <div class="hero-meta">
        <div class="markets">
          <a class="link-arrow" href="/new-york"><span class="dotmark" aria-hidden="true"></span>Explore New York →</a>
          <a class="link-arrow" href="/miami"><span class="dotmark" aria-hidden="true"></span>Explore Miami</a>
        </div>
        <span>Featured · Weddings · Corporate · Brand Activations</span>
      </div>
    </div>
  </section>

  {/* ── Marquee ── */}
  <div class="marquee">
    <div class="marquee-track">
      {MARQUEE_ALL.map((t) => (t === '★' ? <span class="star"></span> : <span>{t}</span>))}
    </div>
  </div>

  {/* ── Belt (editorial intro / manifesto) ── */}
  <section class="belt" id="about">
    <div class="wrap">
      <div class="belt-grid">
        <figure class="framed">
          <Pic src={framedFounders} alt="WOA co-founders Fabio Perez and Hector Taveras behind their bar, in a gilded frame" kind="half" />
        </figure>
        <div class="belt-text">
          <span class="eyebrow">The House</span>
          <p class="display" style="margin-top:16px">
            Hospitality is more than serving drinks. It's <span class="it" style="color:var(--crimson-text)">atmosphere</span>,
            <span class="it"> intention</span>, and the quiet choreography that
            turns an evening into something <span class="it">memorable</span>.
          </p>
          <p style="margin-top:28px;color:var(--fg-dim);font-size:15px;line-height:1.7;max-width:44ch">
            Founded in 2020 by hospitality professionals Fabio Perez and Hector Taveras,
            WOA, short for <em>Work of Art</em>, has grown from a pandemic-born
            cocktail studio in New York into a full beverage and hospitality house
            serving New York and Miami.
          </p>

          <div class="stats">
            {Object.values(houseStats.en).map((stat) => (
              <div class="stat-card"><b>{stat.b}</b><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Services ── */}
  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="ix">[ 01 / Services ]</div>
          <div class="eyebrow" style="margin-top:18px">What we do</div>
        </div>
        <h2 class="display h-lg" style="max-width:16ch">
          Four services, <span class="it" style="color:var(--crimson-text)">one</span> standard.
        </h2>
      </div>
    </div>
    <div class="wrap" style="padding:0">
      <div class="svc cols-4">
        {
          SERVICES.map((s) => (
            <a class="svc-card" id={s.id} href={s.href}>
              <div class="svc-thumb">
                <Pic src={s.img} alt={s.title.join('') + s.it} kind="card" />
                <span class="svc-num">{s.n}</span>
                <span class="svc-tag">{s.tag}</span>
              </div>
              <div class="svc-body">
                <h3 class="svc-title">
                  {s.title.map((t, j) => (
                    <span>{t}{j < s.title.length - 1 ? ' ' : ''}</span>
                  ))}
                  <span class="it">{s.it}</span>
                </h3>
                <p class="svc-desc">{s.desc}</p>
                <ul class="svc-list">{s.list.map((l) => <li>{l}</li>)}</ul>
                <div class="svc-meta">
                  <span>{s.meta}</span>
                  <span class="arr">Learn more →</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Miami ── */}
  <section id="miami">
    <div class="miami">
      <div class="miami-img">
        <Pic src={miamiSunset} alt="WOA rooftop bar at sunset, Miami" kind="half" />
        <span class="miami-cap">[ rooftop · golden hour · WOA mobile bar ]</span>
      </div>
      <div class="miami-body">
        <div class="ix" style="font-family:var(--mono);font-size:11px;color:var(--crimson-text);letter-spacing:0.06em">[ 02 / Miami ]</div>
        <div class="eyebrow" style="margin-top:18px">South Florida</div>
        <h2 class="display h-lg" style="margin-top:18px;max-width:14ch">
          WOA <span class="it" style="color:var(--crimson-text)">in Miami</span>
        </h2>
        <p style="margin-top:24px;color:var(--fg-dim);max-width:44ch;font-size:16px;line-height:1.7">
          WOA Cocktails creates mobile bar experiences for weddings, private events and brand activations at rooftops, estates and hotels from Brickell to Miami Beach.
        </p>
        <ul class="checks">
          <li>Luxury private events</li>
          <li>Weddings</li>
          <li>Rooftop events</li>
          <li>Corporate activations</li>
          <li>Mobile bar experiences</li>
          <li>Cocktail classes</li>
          <li>Beverage consulting</li>
          <li>Hospitality staffing</li>
          <li>Hotel partnerships</li>
          <li>Press &amp; brand activations</li>
        </ul>
        <div style="margin-top:40px;display:flex;gap:14px;flex-wrap:wrap">
          <a href="/contact#inquiry-form" class="btn btn-solid">Get a Quote</a>
          <a href="/contact#schedule" class="btn btn-ghost">Set up a time to chat</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Founders ── */}
  <section class="founders" id="founders">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="ix">[ 03 / Founders ]</div>
          <div class="eyebrow" style="margin-top:18px">A note from the house</div>
        </div>
        <h2 class="display h-lg" style="max-width:16ch">
          Founded by friends. <span class="it" style="color:var(--crimson-text)">Built</span> on hospitality.
        </h2>
      </div>

      <div class="founders-grid">
        <div class="founder-stack">
          <figure class="ph founder-img">
            <Pic src={cocktailHectorMocktail} alt="Hector Taveras, co-founder of WOA Cocktails, behind the bar" kind="portrait" />
            <figcaption style="margin-top:12px;font-family:var(--mono);font-size:11px;letter-spacing:0.08em;color:var(--fg-dim)">HECTOR TAVERAS · NEW YORK</figcaption>
          </figure>
          <figure class="ph founder-img tall" style="transform:translateY(48px)">
            <Pic src={founderFabioPortrait} alt="Fabio Perez, co-founder of WOA Cocktails, pouring behind the bar" kind="portrait" />
            <figcaption style="margin-top:12px;font-family:var(--mono);font-size:11px;letter-spacing:0.08em;color:var(--fg-dim)">FABIO PEREZ · MIAMI</figcaption>
          </figure>
        </div>
        <div style="padding-top:24px">
          <p class="quote">
            What began during a pandemic, two friends making cocktails on camera, became a hospitality house. We believe every pour is a posture. Every gathering, a chance to make something feel intentional. Thank you for letting us host you.
          </p>
          <div class="quote-sig">
            <span class="line"></span>
            <span>Fabio Perez &amp; Hector Taveras · Co-founders</span>
          </div>

          <div class="founder-bios">
            <div>
              <h3 class="eyebrow dim">Hector Taveras</h3>
              <p style="margin-top:10px;color:var(--fg-dim);font-size:16px;line-height:1.7">{founderBios.en.hector}</p>
            </div>
            <div>
              <h3 class="eyebrow dim">Fabio Perez</h3>
              <p style="margin-top:10px;color:var(--fg-dim);font-size:16px;line-height:1.7">{founderBios.en.fabio}</p>
            </div>
          </div>

          <div style="margin-top:40px">
            <a href="/about" class="link-arrow">Read the full story →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeTrust lang="en" />
  <ClientLogos lang="en" />
  <GoogleReviews lang="en" />
  <PressFeature lang="en" />

  {/* ── CTA Band ── */}
  <section class="cta-band" id="contact">
    <div class="cta-band-bg">
      <Pic src={cocktailSunsetMarg} alt="" aria-hidden="true" kind="bg" />
    </div>
    <div class="wrap">
      <div class="eyebrow">Inquire</div>
      <h2 class="display h-xl">
        Let's host <span class="it" style="color:var(--crimson-text)">something</span><br /> unforgettable.
      </h2>
      <p>
        Tell us your event date, location, and vision. {replyTime.en}
      </p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a href="/contact#inquiry-form" class="btn btn-solid">Get a Quote</a>
        <a href="tel:+16463386739" class="btn btn-ghost">Call the house</a>
      </div>
      <div style="margin:80px auto 0;display:grid;grid-template-columns:repeat(3, 1fr);gap:32px;max-width:720px">
        <div>
          <div class="eyebrow dim">Email</div>
          <div style="margin-top:10px;font-size:15px">
            <a href="mailto:hospitality@woacocktails.com" style="color:var(--fg);text-decoration:none">hospitality@woacocktails.com</a>
          </div>
        </div>
        <div>
          <div class="eyebrow dim">New York · Hector</div>
          <div style="margin-top:10px;font-size:15px">
            <a href="tel:+16463386739" style="color:var(--fg);text-decoration:none">646-338-6739</a>
          </div>
        </div>
        <div>
          <div class="eyebrow dim">Miami · Fabio</div>
          <div style="margin-top:10px;font-size:15px">
            <a href="tel:+12159390476" style="color:var(--fg);text-decoration:none">215-939-0476</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
