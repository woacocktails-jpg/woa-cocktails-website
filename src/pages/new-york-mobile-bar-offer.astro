---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import rooftop from '../assets/img/ny-promo-rooftop.jpg';
import indoor from '../assets/img/ny-promo-indoor.jpg';
import cocktails from '../assets/img/new-york-cocktails.webp';
import fullBar from '../assets/img/new-york-full-bar.webp';
import bartender from '../assets/img/new-york-residential.webp';

const description = 'Book three hours of full mobile bar service and enjoy your fourth hour complimentary.';
const quoteUrl = '/contact#inquiry-form';

const gallery = [
  { image: rooftop, alt: 'WOA mobile bar service at a New York rooftop event' },
  { image: indoor, alt: 'WOA mobile bar at an indoor New York event' },
  { image: cocktails, alt: 'WOA bartenders preparing signature cocktails' },
  { image: fullBar, alt: 'WOA luxury mobile bar setup in New York' },
  { image: bartender, alt: 'WOA bartender shaking a cocktail at One High Line' },
];
---

<Layout
  lang="en"
  title="New York Open Bar Offer | WOA Cocktails"
  description={description}
  styles={['woa-service.css']}
  noindex
>
  <main class="svc-page ny-offer">
    <header class="wrap offer-intro">
      <p class="eyebrow">New York · Limited-time offer</p>
      <h1 class="display h-lg">
        ONE HOUR OF COMPLIMENTARY OPEN BAR SERVICE.
        <em>ON US.</em>
      </h1>
    </header>

    <section class="wrap" aria-label="WOA New York event gallery">
      <div class="offer-gallery">
        {gallery.map(({ image, alt }, index) => (
          <div>
            <Pic
              src={image}
              alt={alt}
              kind={index === 0 ? 'half' : 'card'}
              sizes={index === 0
                ? '(max-width: 760px) 100vw, 50vw'
                : '(max-width: 760px) 50vw, 25vw'}
              priority={index === 0}
            />
          </div>
        ))}
      </div>
    </section>

    <section class="wrap offer-details" aria-labelledby="offer-details">
      <div>
        <h2 class="display h-md" id="offer-details">
          The fourth hour is <em>on us.</em>
        </h2>
        <p>{description}</p>
        <a class="btn btn-solid" href={quoteUrl}>
          Request a Quote
          <span class="arr" aria-hidden="true">→</span>
        </a>
        <p class="offer-terms">
          Limited-time offer for qualifying full mobile bar bookings.
          Subject to availability and the terms confirmed in your quote.
        </p>
      </div>

      <div class="offer-inclusions">
        <h2 class="display">What’s included</h2>
        <ul>
          <li>Luxury mobile bar setup and professional bartenders</li>
          <li>A custom cocktail menu with zero-proof options</li>
          <li>Premium mixers, fresh garnishes and bar tools</li>
          <li>Setup, breakdown and a fourth hour of bar service</li>
        </ul>
        <h2 class="display">Where we serve</h2>
        <p>
          New York City, Long Island, the Hamptons and Northern New Jersey.
        </p>
      </div>
    </section>

    <section class="svp-cta">
      <div class="wrap">
        <h2 class="display">
          Tell us about your <em>New York event.</em>
        </h2>
        <p>
          Share your date, venue and guest count, and mention the
          complimentary hour when requesting your quote.
        </p>
        <a class="btn btn-solid" href={quoteUrl}>
          Claim the Offer
          <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .offer-intro {
    padding-top: clamp(112px, 11vw, 160px);
    padding-bottom: clamp(24px, 4vw, 52px);
    text-align: center;
  }

  .offer-intro h1 {
    max-width: 22ch;
    margin: 16px auto 0;
    font-size: clamp(34px, 5.5vw, 76px);
    text-wrap: balance;
  }

  .offer-intro em {
    white-space: nowrap;
  }

  .offer-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, clamp(135px, 17vw, 245px));
    gap: 4px;
    background: var(--line);
  }

  .offer-gallery div {
    min-width: 0;
    overflow: hidden;
  }

  .offer-gallery div:first-child {
    grid-row: span 2;
  }

  .offer-gallery :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .offer-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(26px, 7vw, 100px);
    padding-block: clamp(48px, 8vw, 100px);
  }

  .offer-details p,
  .offer-details li {
    color: var(--fg-dim);
    line-height: 1.65;
  }

  .offer-details p {
    margin-block: 14px 22px;
  }

  .offer-details .offer-terms {
    font-size: 14px;
    margin-bottom: 0;
    max-width: 48ch;
  }

  .offer-inclusions h2 {
    font-size: clamp(28px, 3vw, 38px);
  }

  .offer-inclusions ul {
    margin: 14px 0 24px;
    padding-inline-start: 1.2em;
  }

  .offer-inclusions li + li {
    margin-top: 6px;
  }

  .offer-inclusions p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .offer-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows:
        clamp(200px, 64vw, 435px)
        repeat(2, clamp(100px, 29vw, 200px));
    }

    .offer-gallery div:first-child {
      grid-row: auto;
      grid-column: span 2;
    }

    .offer-details {
      grid-template-columns: 1fr;
    }
  }
</style>
