---
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const brands = [['Nike','nike'],['Adidas','adidas'],['PUMA','puma'],['StockX','stockx'],['Soho House','soho-house'],['Ligne Roset','ligne-roset'],['Adobe','adobe'],['Fujifilm','fujifilm'],['Solana','solana'],['Inbox Monster','inbox-monster'],['Mijenta Tequila','mijenta'],['Bosscal Mezcal','bosscal'],['Chinola','chinola']];
---
<section class="client-strip" aria-labelledby="client-strip-title">
  <h2 id="client-strip-title">{lang === 'es' ? 'Clientes y colaboraciones destacadas' : 'Selected Clients & Collaborations'}</h2>
  <div class="logo-window">
    <div class="logo-track">
      {[0,1].map(copy => <ul aria-hidden={copy === 1 ? 'true' : undefined} class:list={['logo-group', {duplicate: copy === 1}]}>{brands.map(([name, file]) => <li><img src={`/client-logos/${file}.webp`} alt={copy === 1 ? '' : name} width="140" height="48" loading="lazy" decoding="async" /></li>)}</ul>)}
    </div>
  </div>
  <button type="button" class="logo-toggle" aria-pressed="false" data-pause={lang === 'es' ? 'Pausar' : 'Pause'} data-play={lang === 'es' ? 'Reanudar' : 'Resume'}>{lang === 'es' ? 'Pausar' : 'Pause'}</button>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.logo-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      button.closest('.client-strip')?.classList.toggle('paused', paused);
      button.textContent = (paused ? button.dataset.play : button.dataset.pause) || '';
    });
  });
</script>
<style>
.client-strip { position:relative; background:#fff; color:#222; padding:18px 0 14px; overflow:hidden; }
h2 { font-family:var(--mono, sans-serif); font-size:10px; font-weight:500; letter-spacing:.12em; text-transform:uppercase; text-align:center; margin:0 0 12px; }
.logo-window { overflow:hidden; max-width:1200px; margin:auto; }
.logo-track { display:flex; width:max-content; animation:client-scroll 48s linear infinite; }
.logo-group { display:flex; flex:none; list-style:none; padding:0; margin:0; }
li { width:190px; height:48px; display:flex; align-items:center; justify-content:center; }
img { width:140px; height:48px; object-fit:contain; }
.logo-toggle { display:block; margin:4px auto 0; border:0; background:transparent; color:#555; font-size:10px; cursor:pointer; text-decoration:underline; }
.paused .logo-track, .logo-window:hover .logo-track { animation-play-state:paused; }
@keyframes client-scroll { to { transform:translateX(-50%); } }
@media(max-width:600px) { li { width:135px; } img { width:105px; height:42px; } }
@media(prefers-reduced-motion:reduce) { .logo-track { animation:none; } .logo-window { overflow-x:auto; } .duplicate,.logo-toggle { display:none; } }
</style>
